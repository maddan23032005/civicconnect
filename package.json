{
  "name": "civicconnect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:auth": "node services/auth-service/src/index.js",
    "start:profile": "node services/profile-service/src/index.js",
    "start:document": "node services/document-service/src/index.js",
    "start:payment": "node services/payment-service/src/index.js",
    "start:grievance": "node services/grievance-service/src/index.js",
    "start:notification": "node services/notification-service/src/index.js",
    "start:ai": "node services/ai-service/src/index.js",
    "start:gw1": "cross-env GATEWAY_PORT=4000 node gateway/src/index.js",
    "start:gw2": "cross-env GATEWAY_PORT=4001 node gateway/src/index.js",
    "dev": "concurrently -n auth,profile,doc,pay,griev,notif,ai,gw1,gw2 -c cyan,magenta,yellow,green,blue,white,red,gray,gray \"npm:start:auth\" \"npm:start:profile\" \"npm:start:document\" \"npm:start:payment\" \"npm:start:grievance\" \"npm:start:notification\" \"npm:start:ai\" \"npm:start:gw1\" \"npm:start:gw2\"",
    "seed": "node infra/scripts/seed-data.js",
    "ingest": "node infra/scripts/ingest-knowledge.js",
    "health": "node infra/scripts/health-check.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.8.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.8",
    "opossum": "^8.1.4",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3"
  }
}
